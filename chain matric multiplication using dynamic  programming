#include <iostream>
#include <climits>
using namespace std;

void printOptimalParenthesis(int i, int j, int n, int s[][100]) {
    if (i == j) {
        cout << "A" << i;
        return;
    }

    cout << "(";
    printOptimalParenthesis(i, s[i][j], n, s);
    printOptimalParenthesis(s[i][j] + 1, j, n, s);
    cout << ")";
}

int main() {
    int n;

    cout << "Enter number of matrices: ";
    cin >> n;

    int p[100];

    cout << "Enter dimensions of matrices:\n";
    cout << "For A1 = p[0] x p[1], A2 = p[1] x p[2], ...\n";

    for (int i = 0; i <= n; i++) {
        cin >> p[i];
    }

    int dp[100][100];
    int s[100][100]
    for (int i = 1; i <= n; i++) {
        dp[i][i] = 0;
    }

    
    for (int length = 2; length <= n; length++) {

        for (int i = 1; i <= n - length + 1; i++) {

            int j = i + length - 1;
            dp[i][j] = INT_MAX;

            // Try every possible split
            for (int k = i; k < j; k++) {

                int cost = dp[i][k]
                         + dp[k + 1][j]
                         + p[i - 1] * p[k] * p[j];

                if (cost < dp[i][j]) {
                    dp[i][j] = cost;
                    s[i][j] = k;
                }
            }
        }
    }

    cout << "\nMinimum number of scalar multiplications = "
         << dp[1][n] << endl;

    cout << "Optimal Parenthesization = ";
    printOptimalParenthesis(1, n, n, s);
    cout << endl;

    return 0;
}
